# Non-secret Raspberry Pi network deployment settings.
NETWORK_INTERFACE=eth0
WIFI_INTERFACE=wlan0
WIRED_DHCP=true
WIRED_STATIC_ADDRESS=10.42.0.10/24
WIRED_GATEWAY=
WIFI_CONNECTION_NAME=robot-wifi
HOTSPOT_CONNECTION_NAME=robot-hotspot
HOTSPOT_SSID=robot
FALLBACK_NETWORK=192.168.42.0/24
FALLBACK_ROBOT_ADDRESS=192.168.42.1/24
FALLBACK_DHCP_RANGE=192.168.42.100,192.168.42.200,12h
HOTSPOT_CHANNEL=6
WIFI_RETRY_SECONDS=30
NATS_URL=nats://127.0.0.1:4222
ROBOT_HOSTNAME=robot
MEDIA_ROOT=/home/pi/ROV - Cockpit/media
SMB_SHARE_NAME=media
SMB_USER=pi
AVAHI_ENABLED=true
